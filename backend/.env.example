# Every service below is free: open-source software on your own machine, or a free tier.

# ── Server ──
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=auto                # auto = links use whatever address the app connected through (tunnel-friendly)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Database (also the job queue — no Redis needed) ──
# Local (docker compose):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sunozara
# Supabase free tier: Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Auth ──
# dev      → send `Authorization: Bearer dev:<any-uuid>` (local only, refused in production)
# supabase → Supabase Auth free tier (email + Google sign-in)
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=                 # public key, handed to the apps via GET /config

# ── Storage ──
# local    → files on disk in ./storage, served at /files
# supabase → private bucket on the Supabase free tier
STORAGE_DRIVER=local
STORAGE_BUCKET=media
LOCAL_STORAGE_DIR=./storage

# ── Music: ACE-Step 1.5 (MIT license, commercial use OK), self-hosted ──
MUSIC_PROVIDER=mock                 # mock | acestep
ACESTEP_URL=http://localhost:8001   # `uv run acestep-api`
ACESTEP_API_KEY=                    # only if you started it with --api-key

# ── Lyrics & prompt help: any OpenAI-compatible LLM ──
LYRICS_PROVIDER=mock                # mock | openai
# Ollama on your machine (free, private):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# …or a free hosted tier, e.g. Groq (free key at console.groq.com, rate-limited):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# ── Cover art ──
IMAGE_PROVIDER=mock                 # mock | pollinations (free, no key; falls back to mock if busy)
POLLINATIONS_TOKEN=                 # optional free account token: removes watermark + strict rate limit

FFMPEG_PATH=ffmpeg                  # converts to MP3 + reads waveforms
WORKER_CONCURRENCY=1                # one per GPU
WORKER_POLL_MS=1000

# ── Fair-use quota (users never pay) ──
# GPU time is the one limited resource, so each user gets a free daily allowance.
# Set UNLIMITED_CREDITS=true to switch the quota off entirely.
UNLIMITED_CREDITS=false
CREDITS_DAILY_FREE=50               # 50 / 10 = 5 generations (10 songs) per day
CREDITS_PER_GENERATION=10
CREDITS_PER_COVER=2
MAX_ACTIVE_GENERATIONS=2
GENERATIONS_PER_MINUTE=6
REQUESTS_PER_MINUTE=120
DEFAULT_DURATION_SEC=120               # full-length song (2 min)
EXTEND_BY_SEC=30
MAX_DURATION_SEC=240

TOS_VERSION=2026-11-01
